#!/usr/bin/env bash

SCRIPT_DIRECTORY=$(CDPATH="" cd -- "$(dirname -- "$0")" && pwd)

# Link Sublime Text command-line tool
SUBL_APP="/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl"
if [ -x "$SUBL_APP" ]; then
    mkdir -p "$HOME/bin"
    ln -sf "$SUBL_APP" "$HOME/bin/subl"
    echo "Linked subl to ~/bin/subl"
fi

# Workstation components are opt-in because config convergence may require
# explicit drift replacement. Keep package and config changes out of the
# generic platform bootstrap and point to each review-first workflow.
printf '%s\n' \
    "Ghostty workstation setup is available separately:" \
    "  $SCRIPT_DIRECTORY/ghostty/install --plan" \
    "  $SCRIPT_DIRECTORY/ghostty/setup --plan" \
    "Starship workstation setup is available separately:" \
    "  $SCRIPT_DIRECTORY/starship/install --plan" \
    "  $SCRIPT_DIRECTORY/starship/setup --plan"
